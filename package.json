{
  "name": "navido-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "corepack pnpm validate:menu && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "generate:menu": "tsx scripts/normalize-menu.ts",
    "validate:menu": "tsx scripts/normalize-menu.ts --check",
    "verify:home-visual": "playwright test tests/e2e/home-visual.spec.ts --workers=1",
    "verify:menu-visual": "playwright test tests/e2e/menu-visual.spec.ts --workers=1",
    "verify:our-space-visual": "playwright test tests/e2e/our-space-visual.spec.ts --workers=1",
    "verify:about-visual": "playwright test tests/e2e/about-visual.spec.ts --workers=1",
    "verify:visit-visual": "playwright test tests/e2e/visit-visual.spec.ts --workers=1"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "dependencies": {
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5"
}
